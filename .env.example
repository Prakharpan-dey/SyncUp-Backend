# ---- Runtime ----
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# ---- Database ----
DATABASE_URL=postgresql://user:password@localhost:5432/syncup

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- JWT ----
JWT_ACCESS_SECRET=generate-a-strong-secret-min-32-chars
JWT_REFRESH_SECRET=generate-a-different-secret-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY_DAYS=30

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=your-google-client-id

# ---- Firebase (push notifications) ----
# GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# ---- Email (SMTP) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SyncUp <noreply@syncup.app>"

# ---- S3 (file uploads — optional) ----
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=syncup-uploads
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
