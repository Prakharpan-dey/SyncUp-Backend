# Copy to `.env` and fill in. `.env` is gitignored and excluded from Docker
# builds via .dockerignore — never commit it.
#
# Every variable below is validated at startup by src/core/config/env.ts.
# The app refuses to boot on a missing or malformed required value.

# ---- Runtime ----
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# ---- Database (REQUIRED) ----
# Local:  postgresql://syncup:syncup123@localhost:5432/syncup
# Neon:   use the POOLED connection string, and keep ?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/syncup

# Postgres connection pool size. Keep this low on Neon's free tier — it caps
# concurrent connections, and the pooled endpoint multiplexes for you anyway.
DATABASE_POOL_MAX=10

# ---- Redis (REQUIRED) ----
# Backs BullMQ job queues and the rate limiter.
# Local:    redis://localhost:6379
# Upstash:  rediss://... (note the double s — TLS)
REDIS_URL=redis://localhost:6379

# ---- JWT (REQUIRED) ----
# Must be at least 32 characters. Generate with:
#   openssl rand -base64 48
# Refresh tokens are random strings, not JWTs, so only this one secret is used.
JWT_ACCESS_SECRET=generate-a-strong-secret-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY_DAYS=30

# ---- Google OAuth (optional) ----
# Web client ID from the Firebase / Google Cloud console.
# The backend route for this is not implemented yet.
GOOGLE_CLIENT_ID=

# ---- Firebase / push notifications (optional) ----
# Service account JSON for FCM. Without it the notification worker still writes
# rows to the notifications table; it just cannot deliver a push.
# GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# ---- Email / SMTP (optional) ----
# The email worker no-ops unless SMTP_HOST is set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SyncUp <noreply@syncup.app>"
