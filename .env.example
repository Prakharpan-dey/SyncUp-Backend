# Copy to `.env` and fill in. `.env` is gitignored and excluded from Docker
# builds via .dockerignore — never commit it.
#
# Every variable below is validated at startup by src/core/config/env.ts.
# The app refuses to boot on a missing or malformed required value.

# ---- Runtime ----
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# ---- Database (REQUIRED) ----
# Local:  postgresql://syncup:syncup123@localhost:5432/syncup
# Neon:   use the POOLED connection string, and keep ?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/syncup

# Postgres connection pool size. Keep this low on Neon's free tier — it caps
# concurrent connections, and the pooled endpoint multiplexes for you anyway.
DATABASE_POOL_MAX=10

# ---- Redis (REQUIRED) ----
# Backs BullMQ job queues and the rate limiter.
# Local:    redis://localhost:6379
# Upstash:  rediss://... (note the double s — TLS)
REDIS_URL=redis://localhost:6379

# ---- JWT (REQUIRED) ----
# Must be at least 32 characters. Generate with:
#   openssl rand -base64 48
# Refresh tokens are random strings, not JWTs, so only this one secret is used.
JWT_ACCESS_SECRET=generate-a-strong-secret-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY_DAYS=30

# ---- Firebase / push notifications (optional) ----
# Service account credentials for FCM. Without either of these the notification
# worker still writes rows to the notifications table; it just cannot deliver a
# push. Must be set on the service running the WORKER, not just the API.
#
# On a host with no filesystem to put a key file on (Railway, Fly, Render),
# paste the whole downloaded JSON as a single-line value:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...",...}
#
# Locally, a path to the file is easier:
# GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# ---- Email ----
# Must be set on the service running the WORKER, not just the API.
#
# Prefer the HTTP API: Railway and most PaaS providers block outbound SMTP
# ports (25/465/587), so a correct SMTP config still dies with ETIMEDOUT on
# connect. The API is plain HTTPS on 443 and always gets through.
#
# When SMTP_HOST is a Resend host, SMTP_PASS is reused as the API key
# automatically, so RESEND_API_KEY is optional.
RESEND_API_KEY=

# SMTP fallback — works locally, generally not on a PaaS.
#   SMTP_USER is the literal string "resend", not an email address
#   SMTP_PASS is the API key (starts with re_)
#   587 = STARTTLS, 465 = implicit TLS; the worker picks the mode from the port
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=

# The sender domain must be verified with your provider or the send is rejected.
# Recipients are also restricted until a domain is verified.
SMTP_FROM="SyncUp <noreply@zeusdotdev.app>"
