# Secrets — must never enter an image layer.
# The Dockerfile's builder stage does `COPY . .`, so without this the local .env
# is baked into that layer and recoverable via `docker history` even though the
# final stage only copies dist/.
.env
.env.*
!.env.example
firebase-service-account.json
*.pem
*.key

# Reinstalled in-image; copying host modules breaks native builds and bloats layers.
node_modules

# Build output — regenerated by the builder stage.
dist

# VCS and local tooling
.git
.gitignore
.github
.vscode
.idea

# Docs and local-only compose config
README.md
docker-compose.yml
*.md

# Test and coverage artifacts
coverage
tests
*.log
